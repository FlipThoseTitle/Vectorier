<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!--If you are willing to use platform-specific APIs, use conditional compilation.
    See https://docs.avaloniaui.net/docs/guides/platforms/platform-specific-code/dotnet for more details.-->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- Restore every publish target at once, so publishing one after another never finds a restore for the wrong runtime. -->
    <RuntimeIdentifiers>win-x64;linux-x64;osx-x64;osx-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\Vectorier\Assets\vectorier.ico</ApplicationIcon>
    <AssemblyName>Vectorier</AssemblyName>
    <Product>Vectorier</Product>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vectorier\Vectorier.csproj" />
  </ItemGroup>

  <!--
    Vectorier data folders (Editor, Game, Projects) copied next to the executable on build and publish,
    so the app finds its root without asking. Put the three folders in <repo>\Data\, or point elsewhere with
    -p:VectorierDataDir="C:\path\to\Vectorier Folder Structure Example\". Missing folders are skipped.
  -->
  <PropertyGroup>
    <VectorierDataDir Condition="'$(VectorierDataDir)' == ''">$(MSBuildThisFileDirectory)..\Data\</VectorierDataDir>
    <_VectorierData>$([MSBuild]::EnsureTrailingSlash('$(VectorierDataDir)'))</_VectorierData>
    <!-- Set to false to build without copying the data (faster when Projects is large). -->
    <CopyVectorierData Condition="'$(CopyVectorierData)' == ''">true</CopyVectorierData>
  </PropertyGroup>

  <!-- Debug symbols (.pdb, including SkiaSharp / HarfBuzzSharp native ones) are not needed to run: keep them out of
       published builds (dotnet publish with or without a profile). -->
  <PropertyGroup>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>
  <Target Name="ExcludeSymbolsFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

  <Target Name="CollectVectorierData">
    <ItemGroup>
      <VectorierData Include="$(_VectorierData)Editor\**\*" DataFolder="Editor\" />
      <VectorierData Include="$(_VectorierData)Game\**\*" DataFolder="Game\" />
      <VectorierData Include="$(_VectorierData)Projects\**\*" Exclude="$(_VectorierData)Projects\**\.vectorier\**" DataFolder="Projects\" />
    </ItemGroup>
    <Warning Condition="'@(VectorierData)' == ''"
             Text="Vectorier data folders not found in '$(VectorierDataDir)'. Put Editor, Game and Projects there or pass -p:VectorierDataDir=..." />
  </Target>

  <Target Name="CopyVectorierDataOnBuild" AfterTargets="Build" DependsOnTargets="CollectVectorierData"
          Condition="'$(CopyVectorierData)' == 'true'">
    <Copy SourceFiles="@(VectorierData)" DestinationFiles="@(VectorierData->'$(OutDir)%(DataFolder)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyVectorierDataOnPublish" AfterTargets="Publish" DependsOnTargets="CollectVectorierData"
          Condition="'$(CopyVectorierData)' == 'true'">
    <Copy SourceFiles="@(VectorierData)" DestinationFiles="@(VectorierData->'$(PublishDir)%(DataFolder)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
