<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="using:Vectorier.Services.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Vectorier.ViewModels.Editor"
             x:Class="Vectorier.Views.Editor.PreferencesView"
             x:DataType="vm:PreferencesViewModel"
             Background="{DynamicResource AppWindowBackground}" MinWidth="380">
    <StackPanel Margin="16" Spacing="6">
        <TextBlock Classes="section" Text="{l:Tr 'Language'}" Margin="0" />
        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{x:Static vm:PreferencesViewModel.Languages}" SelectedItem="{Binding Language}" />

        <TextBlock Classes="section" Text="{l:Tr 'Appearance'}" Margin="0,10,0,0" />
        <ToggleSwitch IsChecked="{Binding IsDark}" OnContent="{l:Tr 'Dark theme'}" OffContent="{l:Tr 'Light theme'}" />

        <TextBlock Classes="section" Text="{l:Tr 'Scene'}" Margin="0,10,0,0" />
        <TextBlock Classes="label" Text="{l:Tr 'Trigger &amp; Area'}" />
        <CheckBox Content="{l:Tr 'Show Outline'}" IsChecked="{Binding ShowOutline}" ToolTip.Tip="{l:Tr 'Outline around Trigger and Area rectangles'}" />
        <CheckBox Content="{l:Tr 'Show Platform Outline'}" IsChecked="{Binding ShowPlatformOutline}" ToolTip.Tip="{l:Tr 'Outline around Platforms and Trapezoids'}" />
        <CheckBox Content="{l:Tr 'Show Trigger Text'}" IsChecked="{Binding ShowTriggerText}" />
        <CheckBox Content="{l:Tr 'Show Area Text'}" IsChecked="{Binding ShowAreaText}" />
        <CheckBox Content="{l:Tr 'Show Area Type'}" IsChecked="{Binding ShowAreaType}" IsVisible="{Binding ShowAreaText}" Margin="20,0,0,0"
                  ToolTip.Tip="{l:Tr 'Show the type after the name: Area [Animation], CoolArea [Catch]'}" />
        <Grid ColumnDefinitions="110,*" Margin="0,4,0,0">
            <TextBlock Text="{l:Tr 'Text Anchor'}" />
            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{x:Static vm:PreferencesViewModel.Anchors}" SelectedItem="{Binding TextAnchor}" />
        </Grid>

        <TextBlock Classes="section" Text="{l:Tr 'Hierarchy'}" Margin="0,10,0,0" />
        <CheckBox Content="{l:Tr 'Rename Duplicate'}" IsChecked="{Binding RenameDuplicate}"
                  ToolTip.Tip="{l:Tr 'Duplicates keep the original name instead of getting a suffix such as (1)'}" />
        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" MaxWidth="360" HorizontalAlignment="Left"
                   Text="{l:Tr 'When on, a duplicate keeps its name (Cube stays Cube instead of Cube (1)). Spawns always get a unique name within their root.'}" />

        <Button Classes="accent" Content="{l:Tr 'Close'}" HorizontalAlignment="Right" MinWidth="90" Margin="0,12,0,0" Command="{Binding DoneCommand}" IsDefault="True" IsCancel="True" />
    </StackPanel>
</UserControl>
