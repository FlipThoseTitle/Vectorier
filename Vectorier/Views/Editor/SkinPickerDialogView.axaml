<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Vectorier.ViewModels.Editor"
             x:Class="Vectorier.Views.Editor.SkinPickerDialogView"
             x:DataType="vm:SkinPickerDialogViewModel">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource AppToolbarBackground}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="0,0,0,1" Padding="8,6,8,0">
            <StackPanel Orientation="Horizontal" Spacing="2">
                <RadioButton Classes="tab" GroupName="SkinTabs" IsChecked="{Binding IsGearsTab}" Content="Gears" />
                <RadioButton Classes="tab" GroupName="SkinTabs" IsChecked="{Binding IsXmlTab}" Content="XML" />
            </StackPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource AppToolbarBackground}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="0,1,0,0" Padding="12,8">
            <DockPanel>
                <Button DockPanel.Dock="Right" Classes="accent" Content="Done" MinWidth="80" Command="{Binding DoneCommand}" IsDefault="True" />
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Classes="dim" Text="Skins:" />
                    <TextBlock Text="{Binding SkinsText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="460" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Panel>
            <ProgressBar IsIndeterminate="True" VerticalAlignment="Top" Height="3" IsVisible="{Binding IsLoading}" />
            <!-- Gears -->
            <Panel IsVisible="{Binding IsGearsTab}">
                <TextBlock Classes="dim" HorizontalAlignment="Center" VerticalAlignment="Center" Text="This project has no gears."
                           IsVisible="{Binding !Gears.Count}" />
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" Margin="8">
                    <ItemsControl ItemsSource="{Binding Gears}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SkinChoiceViewModel">
                                <ToggleButton Classes="pick-tile" Width="150" Height="170" IsChecked="{Binding IsSelected}" ToolTip.Tip="{Binding XmlName}">
                                    <Grid RowDefinitions="*,Auto">
                                        <Panel>
                                            <Image Source="{Binding Image}" Stretch="Uniform" Width="128" Height="113" />
                                            <TextBlock Classes="dim" FontSize="11" Text="No Image" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       IsVisible="{Binding Image, Converter={x:Static ObjectConverters.IsNull}}" />
                                            <Border Classes="pick-check" IsVisible="{Binding IsSelected}">
                                                <PathIcon Data="{StaticResource Icon.Check}" Width="12" Height="12" Foreground="White" />
                                            </Border>
                                        </Panel>
                                        <TextBlock Grid.Row="1" Text="{Binding DisplayName}" TextAlignment="Center" TextWrapping="Wrap" MaxLines="2"
                                                   TextTrimming="CharacterEllipsis" FontWeight="SemiBold" Margin="0,4,0,0" />
                                    </Grid>
                                </ToggleButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Panel>
            <!-- Model XML files -->
            <Panel IsVisible="{Binding IsXmlTab}">
                <TextBlock Classes="dim" HorizontalAlignment="Center" VerticalAlignment="Center" Text="No XML files in the models folder."
                           IsVisible="{Binding !XmlFiles.Count}" />
                <ScrollViewer Margin="8">
                    <ItemsControl ItemsSource="{Binding XmlFiles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SkinChoiceViewModel">
                                <CheckBox IsChecked="{Binding IsSelected}" Margin="2,1">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <PathIcon Data="{StaticResource Icon.File}" Width="12" Height="12" Opacity="0.7" />
                                        <TextBlock Text="{Binding XmlName}" />
                                        <TextBlock Classes="dim" Text=".xml" />
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Panel>
        </Panel>
    </DockPanel>
</UserControl>
