<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="using:Vectorier.Services.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Vectorier.ViewModels.Editor"
             xmlns:scene="using:Vectorier.Controls.Scene"
             xmlns:models="using:Vectorier.Models.Scene"
             xmlns:views="using:Vectorier.Views.Editor"
             xmlns:c="using:Vectorier.Controls"
             x:Class="Vectorier.Views.Editor.EditorView"
             x:DataType="vm:EditorViewModel"
             Background="{DynamicResource AppWindowBackground}">
    <UserControl.Styles>
        <Style Selector="Border.element-cell">
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <!-- The chosen element type is shown in blue. -->
        <Style Selector="Border.element-cell.active">
            <Setter Property="Background" Value="{DynamicResource AppSelection}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccent}" />
        </Style>
        <Style Selector="Border.element-cell.hidden">
            <Setter Property="Opacity" Value="0.6" />
        </Style>
        <Style Selector="Border.eye:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppHover}" />
        </Style>
    </UserControl.Styles>
    <Panel>
    <DockPanel>
        <!-- ===== Menu ===== -->
        <Menu DockPanel.Dock="Top" Background="{DynamicResource AppToolbarBackground}">
            <MenuItem Header="{l:Tr '_File'}">
                <MenuItem Header="{l:Tr '_New Level'}" Command="{Binding NewLevelCommand}" InputGesture="Ctrl+N" />
                <MenuItem Header="{l:Tr '_Open...'}" Command="{Binding OpenCommand}" InputGesture="Ctrl+O">
                    <MenuItem.Icon><PathIcon Data="{StaticResource Icon.FolderOpen}" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="{l:Tr '_Save'}" Command="{Binding SaveCommand}" InputGesture="Ctrl+S">
                    <MenuItem.Icon><PathIcon Data="{StaticResource Icon.Save}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{l:Tr 'Save _As...'}" Command="{Binding SaveAsCommand}" InputGesture="Ctrl+Shift+S" />
                <Separator />
                <MenuItem Header="{l:Tr '_Play Level'}" Command="{Binding PlayLevelCommand}" InputGesture="F5">
                    <MenuItem.Icon><PathIcon Data="{StaticResource Icon.Play}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{l:Tr 'Play Level in _Hunter Mode'}" Command="{Binding PlayLevelHunterCommand}" InputGesture="Shift+F5">
                    <MenuItem.Icon><PathIcon Data="{StaticResource Icon.Hunter}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{l:Tr '_Level Settings...'}" Command="{Binding OpenLevelSettingsCommand}">
                    <MenuItem.Icon><PathIcon Data="{StaticResource Icon.Tune}" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="{l:Tr 'Live _Collaboration'}" Command="{Binding OpenCollabDropdownCommand}" IsVisible="{Binding CanCollaborateHere}">
                    <MenuItem.Icon><PathIcon Data="{StaticResource Icon.Collab}" /></MenuItem.Icon>
                </MenuItem>
                <Separator IsVisible="{Binding CanCollaborateHere}" />
                <MenuItem Header="{l:Tr '_Quit'}" Command="{Binding QuitCommand}" />
            </MenuItem>
            <MenuItem Header="{l:Tr '_Edit'}">
                <MenuItem Header="{l:Tr '_Undo'}" Command="{Binding UndoCommand}" InputGesture="Ctrl+Z" IsEnabled="{Binding CanUndo}">
                    <MenuItem.Icon><PathIcon Data="{StaticResource Icon.Undo}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{l:Tr '_Redo'}" Command="{Binding RedoCommand}" InputGesture="Ctrl+Y" IsEnabled="{Binding CanRedo}">
                    <MenuItem.Icon><PathIcon Data="{StaticResource Icon.Redo}" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="{l:Tr 'Cu_t'}" Command="{Binding CutCommand}" InputGesture="Ctrl+X">
                    <MenuItem.Icon><PathIcon Data="{StaticResource Icon.Cut}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{l:Tr '_Copy'}" Command="{Binding CopyCommand}" InputGesture="Ctrl+C">
                    <MenuItem.Icon><PathIcon Data="{StaticResource Icon.Copy}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{l:Tr '_Paste'}" Command="{Binding PasteCommand}" InputGesture="Ctrl+V">
                    <MenuItem.Icon><PathIcon Data="{StaticResource Icon.Paste}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{l:Tr 'Paste _Into'}" Command="{Binding PasteIntoCommand}" InputGesture="Ctrl+Shift+V" />
                <MenuItem Header="{l:Tr '_Delete'}" Command="{Binding DeleteCommand}" InputGesture="Delete">
                    <MenuItem.Icon><PathIcon Data="{StaticResource Icon.Delete}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{l:Tr 'Du_plicate'}" Command="{Binding DuplicateCommand}" InputGesture="Ctrl+D">
                    <MenuItem.Icon><PathIcon Data="{StaticResource Icon.Duplicate}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{l:Tr 'Select _All'}" Command="{Binding SelectAllCommand}" InputGesture="Ctrl+A" />
                <MenuItem Header="{l:Tr '_Group'}" Command="{Binding GroupCommand}" InputGesture="Ctrl+G">
                    <MenuItem.Icon><PathIcon Data="{StaticResource Icon.Group}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{l:Tr '_Ungroup'}" Command="{Binding UngroupCommand}" InputGesture="Ctrl+Shift+G"
                          ToolTip.Tip="{l:Tr 'Ungroup (Ctrl+Shift+G)&#10;Turns the object\'s content into separate elements'}" />
                <Separator />
                <MenuItem Header="{l:Tr 'Pr_eferences...'}" Command="{Binding OpenPreferencesCommand}">
                    <MenuItem.Icon><PathIcon Data="{StaticResource Icon.Cog}" /></MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="{l:Tr 'E_lement'}">
                <MenuItem Header="{l:Tr 'Object'}" Command="{Binding CreateFromMenuCommand}" CommandParameter="{x:Static models:ElementType.Object}">
                    <MenuItem.Icon><PathIcon Data="{StaticResource Icon.Object}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{l:Tr 'Image'}" Command="{Binding CreateFromMenuCommand}" CommandParameter="{x:Static models:ElementType.Image}">
                    <MenuItem.Icon><PathIcon Data="{StaticResource Icon.Image}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{l:Tr 'Trigger'}" Command="{Binding CreateFromMenuCommand}" CommandParameter="{x:Static models:ElementType.Trigger}">
                    <MenuItem.Icon><PathIcon Data="{StaticResource Icon.Trigger}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{l:Tr 'Area'}" Command="{Binding CreateFromMenuCommand}" CommandParameter="{x:Static models:ElementType.Area}">
                    <MenuItem.Icon><PathIcon Data="{StaticResource Icon.Area}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{l:Tr 'Platform'}" Command="{Binding CreateFromMenuCommand}" CommandParameter="{x:Static models:ElementType.Platform}">
                    <MenuItem.Icon><PathIcon Data="{StaticResource Icon.Platform}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{l:Tr 'Trapezoid'}" Command="{Binding CreateFromMenuCommand}" CommandParameter="{x:Static models:ElementType.Trapezoid}">
                    <MenuItem.Icon><PathIcon Data="{StaticResource Icon.Trapezoid}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{l:Tr 'Camera'}" Command="{Binding CreateFromMenuCommand}" CommandParameter="{x:Static models:ElementType.Camera}">
                    <MenuItem.Icon><PathIcon Data="{StaticResource Icon.Camera}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{l:Tr 'Spawn'}" Command="{Binding CreateFromMenuCommand}" CommandParameter="{x:Static models:ElementType.Spawn}">
                    <MenuItem.Icon><PathIcon Data="{StaticResource Icon.Spawn}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{l:Tr 'Model'}" Command="{Binding CreateFromMenuCommand}" CommandParameter="{x:Static models:ElementType.Model}">
                    <MenuItem.Icon><PathIcon Data="{StaticResource Icon.Model}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{l:Tr 'Item'}">
                    <MenuItem.Icon><PathIcon Data="{StaticResource Icon.Item}" /></MenuItem.Icon>
                    <MenuItem Header="{l:Tr 'Bonus'}" Command="{Binding CreateItemCommand}" CommandParameter="{x:Static models:ItemType.Bonus}" />
                    <MenuItem Header="{l:Tr 'Coin'}" Command="{Binding CreateItemCommand}" CommandParameter="{x:Static models:ItemType.Coin}" />
                </MenuItem>
                <MenuItem Header="{l:Tr 'Animation'}" Command="{Binding CreateFromMenuCommand}" CommandParameter="{x:Static models:ElementType.Animation}">
                    <MenuItem.Icon><PathIcon Data="{StaticResource Icon.Animation}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{l:Tr 'Particle'}" Command="{Binding CreateFromMenuCommand}" CommandParameter="{x:Static models:ElementType.Particle}">
                    <MenuItem.Icon><PathIcon Data="{StaticResource Icon.Particle}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{l:Tr 'Comment'}" Command="{Binding CreateFromMenuCommand}" CommandParameter="{x:Static models:ElementType.Comment}">
                    <MenuItem.Icon><PathIcon Data="{StaticResource Icon.Comment}" /></MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="{l:Tr '_Help'}">
                <MenuItem Header="{l:Tr '_Tutorial'}" Click="OnHelpTutorial" />
                <MenuItem Header="{l:Tr '_Keybinds'}" Click="OnHelpKeybinds" />
            </MenuItem>
            <MenuItem Header="{l:Tr '_About'}">
                <MenuItem Header="{l:Tr '_GitHub'}" Click="OnHelpGitHub" />
                <MenuItem Header="{l:Tr '_Credits'}" Click="OnHelpCredits" />
                <MenuItem Header="{l:Tr 'Check for _Updates...'}" Click="OnHelpCheckUpdates" />
                <Separator />
                <!-- Version (from the Publish task's version), shown as plain text -->
                <MenuItem Header="{Binding AppVersion}" IsEnabled="False" />
            </MenuItem>
        </Menu>

        <!-- ===== Toolbar ===== -->
        <Border DockPanel.Dock="Top" Classes="toolbar">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Spacing="6" Margin="6,0,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding Paint.IsActive}">
                        <Button Classes="tool" Command="{Binding Paint.DiscardCommand}" ToolTip.Tip="{l:Tr 'Throw the painting away'}">
                            <StackPanel Orientation="Horizontal" Spacing="4"><PathIcon Data="{StaticResource Icon.Close}" /><TextBlock Text="{l:Tr 'Discard'}" /></StackPanel>
                        </Button>
                        <Button Classes="accent" Command="{Binding Paint.ApplyCommand}" ToolTip.Tip="{Binding Paint.SessionTitle, Converter={x:Static l:FormatTrConverter.Instance}, ConverterParameter='{}{0}: save it into the PNG (or as a duplicate)'}">
                            <StackPanel Orientation="Horizontal" Spacing="4"><PathIcon Data="{StaticResource Icon.Save}" /><TextBlock Text="{l:Tr 'Apply'}" /></StackPanel>
                        </Button>
                        <Rectangle Width="1" Margin="2,3" Fill="{DynamicResource AppBorder}" />
                    </StackPanel>
                    <TextBlock Classes="dim" Text="{Binding Project.Name}" />
                    <Button Classes="tool" ToolTip.Tip="{l:Tr 'Back to the Project Manager'}" Command="{Binding QuitCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <PathIcon Data="{StaticResource Icon.ArrowLeft}" />
                            <TextBlock Text="{l:Tr 'Project Manager'}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <!-- Wraps onto a second line when the window is narrow (display scaling above 100%) instead of overlapping. -->
                <WrapPanel ItemSpacing="1" LineSpacing="2">
                    <ToggleButton Classes="tool" ToolTip.Tip="{l:Tr 'Move (Q)&#10;Drag an arrow to move along one axis'}" Name="MoveTool"
                                  Command="{Binding SetToolCommand}" CommandParameter="{x:Static vm:EditorTool.Move}">
                        <PathIcon Data="{StaticResource Icon.Move}" />
                    </ToggleButton>
                    <ToggleButton Classes="tool" ToolTip.Tip="{l:Tr 'Rotate (W)'}" Name="RotateTool"
                                  Command="{Binding SetToolCommand}" CommandParameter="{x:Static vm:EditorTool.Rotate}">
                        <PathIcon Data="{StaticResource Icon.Rotate}" />
                    </ToggleButton>
                    <ToggleButton Classes="tool" ToolTip.Tip="{l:Tr 'Scale (E)&#10;Drag the center to scale evenly'}" Name="ScaleTool"
                                  Command="{Binding SetToolCommand}" CommandParameter="{x:Static vm:EditorTool.Scale}">
                        <PathIcon Data="{StaticResource Icon.Scale}" />
                    </ToggleButton>
                    <ToggleButton Classes="tool" ToolTip.Tip="{l:Tr 'Rect (T)&#10;Drag edges or corners to resize&#10;Drag just outside a corner to rotate'}" Name="RectTool"
                                  Command="{Binding SetToolCommand}" CommandParameter="{x:Static vm:EditorTool.Rect}">
                        <PathIcon Data="{StaticResource Icon.Rect}" />
                    </ToggleButton>
                    <ToggleButton Classes="tool" ToolTip.Tip="{l:Tr 'Brush (B)&#10;Paint a new image, or edit selected ones&#10;[ / ] Brush size'}" Name="BrushTool"
                                  Command="{Binding SetToolCommand}" CommandParameter="{x:Static vm:EditorTool.Brush}">
                        <PathIcon Data="{StaticResource Icon.Brush}" />
                    </ToggleButton>
                    <Rectangle Width="1" Margin="6,3" Fill="{DynamicResource AppBorder}" />
                    <Button Classes="tool" Command="{Binding TogglePivotCommand}" MinWidth="72"
                            ToolTip.Tip="{l:Tr 'Gizmo position&#10;Center: middle of the selection&#10;Pivot: the element\'s position'}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <PathIcon Data="{StaticResource Icon.Crosshair}" />
                            <Panel>
                                <TextBlock Text="{l:Tr 'Center'}" IsVisible="{Binding !UsePivot}" />
                                <TextBlock Text="{l:Tr 'Pivot'}" IsVisible="{Binding UsePivot}" />
                            </Panel>
                        </StackPanel>
                    </Button>
                    <Button Classes="tool" Command="{Binding ToggleLocalModeCommand}" MinWidth="72"
                            ToolTip.Tip="{l:Tr 'Gizmo axes&#10;Global: the Scene\'s axes&#10;Local: the element\'s rotation'}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <PathIcon Data="{StaticResource Icon.Layers}" />
                            <Panel>
                                <TextBlock Text="{l:Tr 'Global'}" IsVisible="{Binding !IsLocalMode}" />
                                <TextBlock Text="{l:Tr 'Local'}" IsVisible="{Binding IsLocalMode}" />
                            </Panel>
                        </StackPanel>
                    </Button>
                    <Rectangle Width="1" Margin="6,3" Fill="{DynamicResource AppBorder}" />
                    <Button Classes="tool" ToolTip.Tip="{l:Tr 'Undo (Ctrl+Z)'}" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}">
                        <PathIcon Data="{StaticResource Icon.Undo}" />
                    </Button>
                    <Button Classes="tool" ToolTip.Tip="{l:Tr 'Redo (Ctrl+Y)'}" Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}">
                        <PathIcon Data="{StaticResource Icon.Redo}" />
                    </Button>
                    <Button Classes="tool" ToolTip.Tip="{l:Tr 'Save (Ctrl+S)'}" Command="{Binding SaveCommand}">
                        <PathIcon Data="{StaticResource Icon.Save}" />
                    </Button>
                    <Rectangle Width="1" Margin="6,3" Fill="{DynamicResource AppBorder}" />
                    <Button Classes="tool" ToolTip.Tip="{l:Tr 'Level Settings'}" Command="{Binding OpenLevelSettingsCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <PathIcon Data="{StaticResource Icon.Tune}" />
                            <TextBlock Text="{l:Tr 'Level Settings'}" />
                        </StackPanel>
                    </Button>
                    <Rectangle Width="1" Margin="6,3" Fill="{DynamicResource AppBorder}" IsVisible="{Binding CanCollaborateHere}" />
                    <Button x:Name="CollabButton" Classes="tool" ToolTip.Tip="{l:Tr 'Live Collaboration'}" IsVisible="{Binding CanCollaborateHere}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Panel>
                                <PathIcon Data="{StaticResource Icon.Collab}" />
                                <!-- Green dot: a session is running. -->
                                <Ellipse Width="7" Height="7" Fill="#2EBD4E" Stroke="{DynamicResource AppToolbarBackground}" StrokeThickness="1"
                                         HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-3,-2" IsVisible="{Binding Collab.IsActive}" />
                            </Panel>
                            <TextBlock Text="{l:Tr 'Live Collaboration'}" />
                        </StackPanel>
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                <MenuItem Header="{l:Tr 'Start Collaboration'}" Command="{Binding StartCollabCommand}" IsVisible="{Binding Collab.IsIdle}" />
                                <MenuItem Header="{l:Tr 'Stop Collaboration'}" Command="{Binding StopCollabCommand}" IsVisible="{Binding Collab.IsHost}" />
                                <MenuItem Command="{Binding CopyCollabCodeCommand}" IsVisible="{Binding Collab.IsActive}" ToolTip.Tip="{l:Tr 'Click to copy the Session ID'}">
                                    <MenuItem.Header>
                                        <StackPanel Spacing="2">
                                            <TextBlock Classes="dim" FontSize="11" Text="{l:Tr 'Session ID (click to copy)'}" />
                                            <TextBlock Text="{Binding Collab.Code}" FontFamily="Consolas,Menlo,DejaVu Sans Mono,monospace" FontSize="11" />
                                        </StackPanel>
                                    </MenuItem.Header>
                                </MenuItem>
                                <Separator IsVisible="{Binding Collab.IsActive}" />
                                <MenuItem Header="{l:Tr 'Join Collaboration'}" Command="{Binding JoinCollabCommand}" IsVisible="{Binding Collab.IsIdle}" />
                                <MenuItem Header="{l:Tr 'Leave Collaboration'}" Command="{Binding LeaveCollabCommand}" IsVisible="{Binding Collab.IsParticipant}" />
                                <MenuItem Header="{l:Tr 'Manage Users'}" Command="{Binding ManageCollabUsersCommand}" IsVisible="{Binding Collab.IsHost}" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>

                    <!-- Brush options (Brush tool only) -->
                    <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsBrushTool}" Margin="6,0,0,0">
                        <Rectangle Width="1" Margin="0,3" Fill="{DynamicResource AppBorder}" />
                        <ComboBox Name="BrushKindBox" ItemsSource="{x:Static vm:PaintViewModel.BrushMenu}" SelectedItem="{Binding Paint.Kind}" Width="112"
                                  ToolTip.Tip="{l:Tr 'Hard: solid edge&#10;Soft: feathered edge&#10;Airbrush: keeps spraying while held&#10;Blur: softens the paint&#10;&#10;Rectangle, Circle: drag a box to fill&#10;Lasso: drag a free shape to fill&#10;Polyline: click points, then click the first point (or press Enter) to fill&#10;Erase removes the shape instead'}">
                            <ComboBox.DataTemplates>
                                <DataTemplate DataType="vm:BrushMenuDivider">
                                    <Rectangle Height="1" Fill="{DynamicResource AppBorder}" />
                                </DataTemplate>
                            </ComboBox.DataTemplates>
                        </ComboBox>
                        <TextBlock Text="{l:Tr 'Size'}" Classes="dim" VerticalAlignment="Center" Margin="4,0,0,0" />
                        <NumericUpDown IsEnabled="{Binding !Paint.IsShape}" Value="{Binding Paint.Size, Converter={x:Static c:DoubleToDecimalConverter.Instance}}" Minimum="1" Maximum="1000"
                                       FormatString="0.#" Width="64" ShowButtonSpinner="False" VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Left" ToolTip.Tip="{l:Tr 'Brush size ([ / ])'}" />
                        <TextBlock Text="{l:Tr 'Opacity'}" Classes="dim" VerticalAlignment="Center" Margin="4,0,0,0" />
                        <NumericUpDown Value="{Binding Paint.Opacity, Converter={x:Static c:DoubleToDecimalConverter.Instance}}" Minimum="0" Maximum="100"
                                       FormatString="0'%'" Width="58" ShowButtonSpinner="False" VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Left" />
                        <ColorPicker Color="{Binding Paint.Color}" IsAlphaEnabled="False" VerticalAlignment="Center" ToolTip.Tip="{l:Tr 'Brush color'}" />
                        <ComboBox ItemsSource="{x:Static vm:PaintViewModel.BlendModes}" SelectedItem="{Binding Paint.Blend}" Width="100"
                                  ToolTip.Tip="{l:Tr 'Blending mode'}" IsEnabled="{Binding !Paint.Erase}" />
                        <CheckBox Content="{l:Tr 'Erase'}" IsChecked="{Binding Paint.Erase}" Margin="4,0,0,0"
                                  ToolTip.Tip="{l:Tr 'The brush removes paint instead of adding color'}" />
                        <CheckBox Content="{l:Tr 'Clip to Image'}" IsChecked="{Binding Paint.ClipToBounds}" Margin="4,0,0,0" IsEnabled="{Binding !Paint.IsNew}"
                                  ToolTip.Tip="{l:Tr 'On: paint only on visible pixels&#10;Off: paint anywhere, the image grows'}" />
                    </StackPanel>
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- ===== Status bar ===== -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource AppHeaderBackground}" BorderBrush="{DynamicResource AppBorder}"
                BorderThickness="0,1,0,0" Padding="8,2">
            <DockPanel>
                <TextBlock Text="{Binding StatusText}" FontSize="11" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <Grid ColumnDefinitions="Auto,250,4,*,4,340" Name="MainGrid">
            <!-- ===== Element Bar ===== -->
            <Border Grid.Column="0" Background="{DynamicResource AppHeaderBackground}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl Name="ElementBar" ItemsSource="{Binding ElementTypes}" Margin="2,4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ElementTypeInfo">
                                <Grid ColumnDefinitions="Auto,*" Margin="0,1">
                                    <!-- Eye: shows / hides this element type in the Scene. Drag across several eyes to set them all. -->
                                    <Border Classes="eye" Tag="{Binding}" Width="20" Background="Transparent" VerticalAlignment="Stretch" Margin="0,0,1,0"
                                            ToolTip.Tip="{l:Tr 'Show / hide&#10;Drag across to change several'}">
                                        <Panel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <PathIcon Data="{StaticResource Icon.Eye}" Width="14" Height="14" IsVisible="{Binding IsVisible}" />
                                            <PathIcon Data="{StaticResource Icon.EyeOff}" Width="14" Height="14" IsVisible="{Binding !IsVisible}" Opacity="0.55" />
                                        </Panel>
                                    </Border>
                                    <Border Grid.Column="1" Classes="element-cell" Classes.active="{Binding IsActive}" Classes.hidden="{Binding !IsVisible}"
                                            ToolTip.Tip="{Binding ToolTip}">
                                        <Button Classes="tool element" Width="58" Padding="2,3" Tag="{Binding}" Click="OnElementTypeClick">
                                            <StackPanel Spacing="1">
                                                <PathIcon Data="{Binding Icon}" Width="18" Height="18" HorizontalAlignment="Center" />
                                                <TextBlock Text="{Binding Name}" FontSize="10" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- ===== Hierarchy ===== -->
            <views:HierarchyView Grid.Column="1" Name="HierarchyPanel" />
            <GridSplitter Grid.Column="2" ResizeDirection="Columns" />

            <!-- ===== Center: Scene + bottom panel ===== -->
            <Grid Grid.Column="3" RowDefinitions="*,4,260" Name="CenterGrid">
                <Border Grid.Row="0" Classes="panel" BorderThickness="1,0,1,1">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Classes="panel-header">
                            <Grid ColumnDefinitions="*,Auto,*" Name="SceneHeaderGrid">
                                <StackPanel Orientation="Horizontal" Spacing="2" Margin="-4,-3,0,-3" Name="SceneTabsPanel">
                                    <RadioButton Classes="tab" GroupName="SceneTabs" IsChecked="{Binding IsSceneViewTab}" ToolTip.Tip="{l:Tr 'Edit the level'}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <PathIcon Data="{StaticResource Icon.Layers}" />
                                            <TextBlock Text="{l:Tr 'Scene'}" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Classes="tab" GroupName="SceneTabs" IsChecked="{Binding IsGameViewTab}"
                                                 ToolTip.Tip="{l:Tr 'Game View&#10;See what the Camera sees, or play the level'}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <PathIcon Data="{StaticResource Icon.Play}" />
                                            <TextBlock Text="{l:Tr 'Game'}" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Classes="tab" GroupName="SceneTabs" IsChecked="{Binding IsObjectTab}" IsVisible="{Binding IsEditingObject}"
                                                 ToolTip.Tip="{l:Tr 'Editing an object definition'}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <PathIcon Data="{StaticResource Icon.Object}" Foreground="#E65100" />
                                            <TextBlock Text="{Binding ObjectTabTitle}" />
                                            <Button Classes="tab-close" Command="{Binding CloseObjectEditCommand}" Padding="2" Margin="2,-2,-4,-2"
                                                    Background="Transparent" BorderThickness="0" VerticalAlignment="Center" ToolTip.Tip="{l:Tr 'Close'}">
                                                <PathIcon Data="{StaticResource Icon.Close}" Width="9" Height="9" />
                                            </Button>
                                        </StackPanel>
                                    </RadioButton>
                                </StackPanel>
                                <!-- Play buttons at the top center of the Scene -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                                    <Button Classes="tool" Command="{Binding StopGameCommand}" IsVisible="{Binding IsGameRunning}" Name="StopGameButton"
                                            ToolTip.Tip="{l:Tr 'Stop playing and go back to the level'}">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <PathIcon Data="{StaticResource Icon.Stop}" Foreground="#C62828" />
                                            <TextBlock Text="{l:Tr 'Stop'}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="tool" Command="{Binding PlayLevelCommand}" IsVisible="{Binding ShowPlayButtons}" ToolTip.Tip="{l:Tr 'Play Level (F5)'}">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <PathIcon Data="{StaticResource Icon.Play}" Foreground="#2E7D32" />
                                            <TextBlock Text="{l:Tr 'Play'}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="tool" Command="{Binding PlayLevelHunterCommand}" IsVisible="{Binding ShowPlayButtons}" ToolTip.Tip="{l:Tr 'Play Level in Hunter Mode (Shift+F5)'}">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <PathIcon Data="{StaticResource Icon.Hunter}" Foreground="#C62828" />
                                            <TextBlock Text="{l:Tr 'Hunter Mode'}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock Grid.Column="2" HorizontalAlignment="Right" Classes="dim" FontSize="11" Name="ZoomText" Margin="6,0,0,0" />
                            </Grid>
                        </Border>
                        <Panel>
                            <scene:SceneView Name="Scene" Editor="{Binding}" IsVisible="{Binding ShowsSceneView}" />
                            <scene:SceneView Name="GameScene" Editor="{Binding}" IsGameView="True" IsVisible="{Binding IsGameViewTab}" />
                            <!-- Play / Hunter Mode / Play Here: the level is played here, in the Game View. -->
                            <c:GameView Name="GamePlay" ToolTip.Tip="{x:Null}">
                                <c:GameView.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding Path="IsGameViewTab" />
                                        <Binding Path="IsGameRunning" />
                                        <Binding Path="!IsGameFullScreen" />
                                    </MultiBinding>
                                </c:GameView.IsVisible>
                            </c:GameView>
                            <!-- Placement hint -->
                            <Border IsVisible="{Binding ShowPlacementHint}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8"
                                    Background="#E6FFFFFF" BorderBrush="#0078D7" BorderThickness="1" CornerRadius="2" Padding="6,3" IsHitTestVisible="False">
                                <TextBlock Text="{Binding PlacementHint}" Foreground="#0B4F8A" FontSize="11" />
                            </Border>
                            <ProgressBar IsIndeterminate="True" VerticalAlignment="Top" Height="3" IsVisible="{Binding IsLoading}" />
                        </Panel>
                    </DockPanel>
                </Border>
                <GridSplitter Grid.Row="1" ResizeDirection="Rows" />
                <DockPanel Grid.Row="2">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="2,2,0,0">
                        <RadioButton Classes="tab" GroupName="BottomTabs" IsChecked="{Binding IsProjectTab}">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <PathIcon Data="{StaticResource Icon.Folder}" Width="12" Height="12" />
                                <TextBlock Text="{l:Tr 'Project'}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Classes="tab" GroupName="BottomTabs" IsChecked="{Binding IsDynamicEditorTab}">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <PathIcon Data="{StaticResource Icon.Timeline}" Width="12" Height="12" />
                                <TextBlock Text="{l:Tr 'Dynamic Editor'}" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                    <Border Classes="panel">
                        <Panel>
                            <Panel IsVisible="{Binding IsProjectTab}"><views:ProjectWindowView DataContext="{Binding ProjectWindow}" /></Panel>
                            <Panel IsVisible="{Binding IsDynamicEditorTab}"><views:DynamicEditorView DataContext="{Binding Dynamics}" /></Panel>
                        </Panel>
                    </Border>
                </DockPanel>
                <!-- Trigger Editor: opens over the Scene and the bottom panel, and stays until closed -->
                <ContentControl Grid.RowSpan="3" Name="TriggerEditorHost" Content="{Binding TriggerEditor}"
                                IsVisible="{Binding TriggerEditor, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </Grid>
            <GridSplitter Grid.Column="4" ResizeDirection="Columns" />

            <!-- ===== Right: Inspector | Move Visualizer ===== -->
            <DockPanel Grid.Column="5">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="2,2,0,0">
                    <RadioButton Classes="tab" GroupName="RightTabs" IsChecked="{Binding IsInspectorTab}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <PathIcon Data="{StaticResource Icon.Info}" Width="12" Height="12" />
                            <TextBlock Text="{l:Tr 'Inspector'}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Classes="tab" GroupName="RightTabs" IsChecked="{Binding IsMoveVisualizerTab}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <PathIcon Data="{StaticResource Icon.RunFast}" Width="12" Height="12" />
                            <TextBlock Text="{l:Tr 'Move Visualizer'}" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
                <Border Classes="panel">
                    <Panel>
                        <Panel IsVisible="{Binding IsInspectorTab}"><views:InspectorView DataContext="{Binding Inspector}" /></Panel>
                        <Panel IsVisible="{Binding IsMoveVisualizerTab}"><views:MoveVisualizerView DataContext="{Binding MoveVisualizer}" /></Panel>
                    </Panel>
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
    <!-- The game's Full Screen (F11): the Game View fills the editor's window. -->
    <c:GameView Name="GameFull" IsVisible="False" />
    </Panel>
</UserControl>
