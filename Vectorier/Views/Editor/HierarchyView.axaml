<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Vectorier.ViewModels.Editor"
             x:Class="Vectorier.Views.Editor.HierarchyView"
             x:DataType="vm:EditorViewModel">
    <UserControl.Styles>
        <!-- Rows draw their own selection: the ListBox is only used for its virtualization. -->
        <Style Selector="ListBox.rows ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.rows ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.rows ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.row">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.row:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppHover}" />
        </Style>
        <Style Selector="Border.row.selected">
            <Setter Property="Background" Value="{DynamicResource AppSelection}" />
        </Style>
        <Style Selector="Border.row.dropinside">
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccent}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.row-eye">
            <Setter Property="Opacity" Value="0.35" />
        </Style>
        <Style Selector="Border.row-eye:pointerover">
            <Setter Property="Opacity" Value="0.9" />
        </Style>
        <Style Selector="Border.row-eye.hidden">
            <Setter Property="Opacity" Value="0.75" />
        </Style>
        <Style Selector="ToggleButton.expander">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="Transparent" Width="14" Height="18">
                        <PathIcon Name="Chevron" Data="{StaticResource Icon.ChevronRight}" Width="10" Height="10" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ToggleButton.expander:checked /template/ PathIcon#Chevron">
            <Setter Property="RenderTransform" Value="rotate(90deg)" />
        </Style>
    </UserControl.Styles>

    <Border Classes="panel" BorderThickness="1,0,1,1">
        <DockPanel>
            <Border DockPanel.Dock="Top" Classes="panel-header">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Classes="tool" Padding="2" MinWidth="20" MinHeight="18" Click="OnToggleAllVisibility"
                            ToolTip.Tip="Show everything if something is hidden, otherwise hide everything">
                        <PathIcon Name="AllEyeIcon" Data="{StaticResource Icon.Eye}" Width="13" Height="13" />
                    </Button>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource Icon.Layers}" />
                        <TextBlock Classes="header" Text="Hierarchy" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <TextBox DockPanel.Dock="Top" Margin="4" PlaceholderText="Search…" Text="{Binding Hierarchy.FilterText}" />
            <Panel>
                <ListBox Name="RowList" Classes="rows" ItemsSource="{Binding Hierarchy.Rows}" Background="Transparent" BorderThickness="0"
                         SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:HierarchyRow">
                            <Border Classes="row" Classes.selected="{Binding Element.IsSelected, FallbackValue=False}" Height="20" Tag="{Binding}">
                                <DockPanel>
                                <!-- Eye: hides the element in the Scene (editor only) -->
                                <Border DockPanel.Dock="Left" Classes="row-eye" Classes.hidden="{Binding Element.IsHidden, FallbackValue=False}"
                                        Width="18" Background="Transparent" IsVisible="{Binding !IsRoot}" ToolTip.Tip="Show / hide in the Scene">
                                    <Panel>
                                        <PathIcon Data="{StaticResource Icon.Eye}" Width="12" Height="12" IsVisible="{Binding !Element.IsHidden, FallbackValue=True}" />
                                        <PathIcon Data="{StaticResource Icon.EyeOff}" Width="12" Height="12" IsVisible="{Binding Element.IsHidden, FallbackValue=False}" />
                                    </Panel>
                                </Border>
                                <StackPanel Orientation="Horizontal" Margin="{Binding Indent}" Spacing="3">
                                    <Panel Width="14">
                                        <ToggleButton Classes="expander" IsVisible="{Binding HasChildren}" Focusable="False"
                                                      IsChecked="{Binding Element.IsExpanded, Mode=OneWay, FallbackValue=False}"
                                                      Tag="{Binding}" Click="OnExpanderClick" />
                                    </Panel>
                                    <PathIcon Data="{Binding Icon}" Width="12" Height="12" />
                                    <TextBlock Text="{Binding RootName}" FontWeight="SemiBold" IsVisible="{Binding IsRoot}" />
                                    <TextBlock Text="{Binding Element.DisplayName, FallbackValue=''}" IsVisible="{Binding !IsRoot}" />
                                    <PathIcon Data="{StaticResource Icon.Link}" Width="11" Height="11" IsVisible="{Binding IsReference}"
                                              ToolTip.Tip="Content from the level's Sets" Opacity="0.7" />
                                </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <!-- Rectangle selection -->
                <Border Name="Marquee" IsVisible="False" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top"
                        Background="#300078D7" BorderBrush="#0078D7" BorderThickness="1" />
                <!-- Drop indicator for drag reordering -->
                <Rectangle Name="DropLine" Height="2" Fill="{DynamicResource AppAccent}" VerticalAlignment="Top" HorizontalAlignment="Stretch"
                           IsVisible="False" IsHitTestVisible="False" />
            </Panel>
        </DockPanel>
    </Border>
</UserControl>
