<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Vectorier.ViewModels.Editor"
             xmlns:c="using:Vectorier.Controls"
             xmlns:views="using:Vectorier.Views.Editor"
             x:Class="Vectorier.Views.Editor.ProjectWindowView"
             x:DataType="vm:ProjectWindowViewModel"
             Focusable="True">
    <UserControl.Styles>
        <Style Selector="ListBox.rows ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <Style Selector="ListBox.rows ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.rows ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.tile">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="3" />
        </Style>
        <Style Selector="Border.tile:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppHover}" />
        </Style>
        <Style Selector="Border.tile.selected">
            <Setter Property="Background" Value="{DynamicResource AppSelection}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppSelectionBorder}" />
        </Style>
        <Style Selector="Border.tile.disabled">
            <Setter Property="Opacity" Value="0.55" />
        </Style>
        <Style Selector="Border.folder">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="6,3" />
        </Style>
        <Style Selector="Border.folder:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppHover}" />
        </Style>
        <Style Selector="Border.folder.selected">
            <Setter Property="Background" Value="{DynamicResource AppSelection}" />
        </Style>
        <Style Selector="Border.folder.drop">
            <Setter Property="Background" Value="{DynamicResource AppSelectionBorder}" />
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="200,4,*">
        <!-- ===== Folders ===== -->
        <DockPanel Grid.Column="0" IsVisible="{Binding ShowsFolders}">
            <Border DockPanel.Dock="Top" Classes="panel-header">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Classes="tool" Padding="2" MinWidth="22" MinHeight="22" Command="{Binding CreateFolderCommand}"
                            ToolTip.Tip="New folder (Objects: new XML file)">
                        <PathIcon Data="{StaticResource Icon.FolderPlus}" Width="13" Height="13" />
                    </Button>
                    <Button DockPanel.Dock="Right" Classes="tool" Padding="2" MinWidth="22" MinHeight="22" Command="{Binding ReloadCommand}" ToolTip.Tip="Reload">
                        <PathIcon Data="{StaticResource Icon.Refresh}" Width="13" Height="13" />
                    </Button>
                    <TextBlock Classes="header" Text="{Binding Header}" />
                </DockPanel>
            </Border>
            <TextBox DockPanel.Dock="Top" Height="22" MinHeight="22" Padding="6,2" Margin="4,3" PlaceholderText="Search…"
                     Text="{Binding FolderSearchText}" VerticalContentAlignment="Center" />
            <Panel>
            <ScrollViewer Name="FolderScroll" Background="Transparent">
                <ItemsControl Name="FolderList" ItemsSource="{Binding Folders}" Background="Transparent">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PwFolder">
                            <Border Classes="folder" Classes.selected="{Binding IsSelected}" Tag="{Binding}">
                                <DockPanel>
                                    <!-- Object XML type (like the "Anim" badge of animated textures) -->
                                    <Border DockPanel.Dock="Right" IsVisible="{Binding HasTypeBadge}" CornerRadius="3" Padding="4,0" Margin="4,0,2,0"
                                            VerticalAlignment="Center" Background="{DynamicResource AppAccent}" Opacity="0.85"
                                            ToolTip.Tip="Object XML type (right click › Type to change)">
                                        <TextBlock Text="{Binding TypeBadge}" FontSize="9" FontWeight="SemiBold" Foreground="White" />
                                    </Border>
                                    <!-- A Grid (not a StackPanel) so the name is trimmed before the badge instead of running under it. -->
                                    <Grid ColumnDefinitions="Auto,*">
                                        <Panel Width="13" Margin="0,0,6,0">
                                            <PathIcon Data="{StaticResource Icon.FileXml}" IsVisible="{Binding IsFile}" Width="13" Height="13" />
                                            <PathIcon Data="{StaticResource Icon.Folder}" IsVisible="{Binding !IsFile}" Width="13" Height="13" />
                                        </Panel>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                                    </Grid>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <!-- Reorder indicator (like the Hierarchy): where the dragged folders will go -->
            <Border Name="FolderDropLine" Height="2" Background="{DynamicResource AppAccent}" VerticalAlignment="Top" HorizontalAlignment="Stretch"
                    IsHitTestVisible="False" IsVisible="False" Margin="2,0" />
            </Panel>
        </DockPanel>
        <GridSplitter Grid.Column="1" ResizeDirection="Columns" IsVisible="{Binding ShowsFolders}" />

        <!-- ===== Content ===== -->
        <DockPanel Grid.Column="2" Name="ContentArea">
            <Border DockPanel.Dock="Top" Classes="panel-header">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" IsVisible="{Binding ShowsItems}"
                                ToolTip.Tip="Tile size">
                        <PathIcon Data="{StaticResource Icon.Minus}" Width="9" Height="9" Opacity="0.6" />
                        <Slider Width="90" Minimum="48" Maximum="200" SmallChange="4" LargeChange="16" Margin="0,-10"
                                Value="{Binding TileSize}" VerticalAlignment="Center" />
                        <PathIcon Data="{StaticResource Icon.Plus}" Width="9" Height="9" Opacity="0.6" />
                    </StackPanel>
                    <TextBox DockPanel.Dock="Right" Width="180" Height="22" MinHeight="22" Padding="6,2" Margin="0,2,8,2" PlaceholderText="Search…"
                             Text="{Binding SearchText}" IsVisible="{Binding ShowsItems}" VerticalContentAlignment="Center" />
                    <Button DockPanel.Dock="Right" Classes="tool" Padding="2" MinWidth="22" MinHeight="22" Margin="0,0,6,0" Command="{Binding ImportCommand}"
                            IsVisible="{Binding CanImport}" ToolTip.Tip="{Binding ImportLabel}">
                        <PathIcon Data="{StaticResource Icon.Import}" Width="13" Height="13" />
                    </Button>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Classes="header" Text="{Binding ContentTitle}" IsVisible="{Binding ShowsFolders}" />
                        <TextBlock Classes="header" Text="{Binding Header}" IsVisible="{Binding !ShowsFolders}" />
                        <TextBlock Classes="dim" Text="{Binding Items.Count, StringFormat='({0})'}" IsVisible="{Binding ShowsItems}" />
                        <ProgressBar IsIndeterminate="True" Width="60" Height="3" IsVisible="{Binding IsBusy}" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Panel Name="DropArea" Background="Transparent" DragDrop.AllowDrop="True">
                <TextBlock Classes="dim" Text="{Binding EmptyText}" TextWrapping="Wrap" Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" Name="EmptyHint" />
                <ListBox Name="TileRows" Classes="rows" Background="Transparent" BorderThickness="0" SelectionMode="Single"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="views:TileRow">
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PwItem">
                                        <Border Classes="tile" Classes.selected="{Binding IsSelected}" Classes.disabled="{Binding !CanPlace}" Tag="{Binding}"
                                                AttachedToVisualTree="OnTileAttached"
                                                Width="{Binding $parent[views:ProjectWindowView].TileWidth}" ToolTip.Tip="{Binding ToolTip}">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Bottom" Text="{Binding Label}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                           HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                <Border Classes="thumbnail" Height="{Binding $parent[views:ProjectWindowView].ThumbHeight}">
                                                    <Panel>
                                                        <c:TexturePreview Library="{Binding $parent[views:ProjectWindowView].Library}" TextureName="{Binding PreviewTexture}" Entry="{Binding Texture}"
                                                                          IsVisible="{Binding PreviewTexture, Converter={x:Static ObjectConverters.IsNotNull}}" Margin="2" />
                                                        <c:ObjectPreview Library="{Binding $parent[views:ProjectWindowView].Library}" Definition="{Binding Definition}"
                                                                         IsVisible="{Binding Definition, Converter={x:Static ObjectConverters.IsNotNull}}" Margin="2" />
                                                        <Path Data="{Binding Silhouette}" Fill="Black" Stretch="Uniform" Margin="4"
                                                              IsVisible="{Binding Silhouette, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                        <PathIcon Data="{StaticResource Icon.Trigger}" Width="28" Height="28" Foreground="#CE7D14"
                                                                  IsVisible="{Binding Trigger, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                        <PathIcon Data="{StaticResource Icon.Area}" Width="28" Height="28" Foreground="#800000"
                                                                  IsVisible="{Binding Area, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                        <PathIcon Data="{StaticResource Icon.Model}" Width="24" Height="24" Opacity="0.35"
                                                                  IsVisible="{Binding ShowModelPlaceholder}" />
                                                    </Panel>
                                                </Border>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Panel>
        </DockPanel>
    </Grid>
</UserControl>
