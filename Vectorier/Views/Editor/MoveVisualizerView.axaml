<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="using:Vectorier.Services.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Vectorier.ViewModels.Editor"
             xmlns:c="using:Vectorier.Controls"
             x:Class="Vectorier.Views.Editor.MoveVisualizerView"
             x:DataType="vm:MoveVisualizerViewModel">
    <UserControl.Styles>
        <Style Selector="Grid.row">
            <Setter Property="Margin" Value="0,2" />
        </Style>
        <Style Selector="Grid.row > TextBlock:nth-child(1)">
            <Setter Property="Foreground" Value="{DynamicResource AppForegroundDim}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="NumericUpDown, TextBox, ComboBox">
            <Setter Property="MinHeight" Value="24" />
        </Style>
        <Style Selector="TextBlock.section">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,4,0,4" />
        </Style>
        <Style Selector="Border.box">
            <Setter Property="Background" Value="{DynamicResource AppPanelAltBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="8" />
        </Style>
        <Style Selector="CheckBox.indented">
            <Setter Property="Margin" Value="16,0,0,0" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="10" Spacing="2">
            <!-- ===== Settings ===== -->
            <TextBlock Classes="section" Text="{l:Tr 'Settings'}" />
            <CheckBox Content="{l:Tr 'Render Trajectory'}" IsChecked="{Binding RenderTrajectory}" IsVisible="{Binding IsAnimationMode}"
                      ToolTip.Tip="{l:Tr 'Draw the path of the center of mass'}" />
            <CheckBox Content="{l:Tr 'Follow Camera'}" IsChecked="{Binding FollowCamera}"
                      ToolTip.Tip="{l:Tr 'Keep the Scene View centered on the model\'s Camera node (in Gameplay the Game View always follows it)'}" />
            <CheckBox Content="{l:Tr 'Reverse'}" IsChecked="{Binding Reverse}" IsVisible="{Binding IsAnimationMode}" ToolTip.Tip="{l:Tr 'Mirror the move (runs to the left)'}" />
            <CheckBox Content="{l:Tr 'Reverse'}" IsChecked="{Binding Reverse}" IsVisible="{Binding IsGameplayMode}"
                      ToolTip.Tip="{l:Tr 'Spawn the runner again where it last spawned, running to the left (JumpOff|18|1)'}" />

            <!-- ===== Spawn ===== -->
            <StackPanel Margin="0,10,0,0" Spacing="2" IsVisible="{Binding !ShowsSelectedTrickArea}">
                <Grid Classes="row" ColumnDefinitions="110,*">
                    <TextBlock Text="{l:Tr 'Spawn Mode'}" />
                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{x:Static vm:MoveVisualizerViewModel.SpawnModes}"
                              SelectedItem="{Binding SpawnMode}"
                              ToolTip.Tip="{l:Tr 'Animation: plays a move where you click. Gameplay: spawns a runner you play with the arrow keys.'}" />
                </Grid>

                <Grid Classes="row" ColumnDefinitions="110,*" IsVisible="{Binding IsAnimationMode}">
                    <TextBlock Text="{l:Tr 'Animation'}" />
                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{x:Static vm:MoveVisualizerViewModel.MovementTypes}"
                              SelectedItem="{Binding MovementType}" />
                </Grid>

                <Grid Classes="row" ColumnDefinitions="110,*,Auto">
                    <TextBlock Text="{l:Tr 'Pivot Node'}" />
                    <TextBox Grid.Column="1" Text="{Binding PivotNodeName}" />
                    <Button Grid.Column="2" Classes="tool" Margin="2,0,0,0" ToolTip.Tip="{l:Tr 'Presets'}">
                        <PathIcon Data="{StaticResource Icon.ChevronDown}" Width="10" Height="10" />
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuItem Header="NPivot" Command="{Binding SetPivotCommand}" CommandParameter="NPivot" />
                                <MenuItem Header="DetectorH" Command="{Binding SetPivotCommand}" CommandParameter="DetectorH" />
                                <MenuItem Header="DetectorV" Command="{Binding SetPivotCommand}" CommandParameter="DetectorV" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
            </StackPanel>

            <Border Classes="box" Margin="0,10,0,0" IsVisible="{Binding ShowsSelectedTrickArea}">
                <StackPanel Spacing="2">
                    <Grid ColumnDefinitions="120,*">
                        <TextBlock Classes="dim" Text="{l:Tr 'Selected Area'}" />
                        <TextBlock Grid.Column="1" Text="{Binding SelectedAreaName}" TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <Grid ColumnDefinitions="120,*">
                        <TextBlock Classes="dim" Text="{l:Tr 'Preview Source'}" />
                        <TextBlock Grid.Column="1" Text="{l:Tr 'moves.xml › ReactionGroups › TrickGroup'}" TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===== Main buttons ===== -->
            <Button Margin="0,12,0,0" Height="56" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    Classes="accent" Command="{Binding MainButtonCommand}" Content="{Binding MainButtonText}" FontSize="14" IsEnabled="{Binding !IsBusy}" />
            <Button Height="36" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    Command="{Binding ClearCommand}" Content="{l:Tr 'Clear'}" />
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Classes="dim" Margin="0,4,0,0"
                       IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <!-- ===== Playback (Animation) ===== -->
            <StackPanel IsVisible="{Binding IsAnimationMode}">
                <Grid ColumnDefinitions="*,6,*" Margin="0,10,0,0">
                    <Button Height="30" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding PlayPauseCommand}"
                            Content="{Binding PlayButtonText}" IsEnabled="{Binding HasFrames}" />
                    <Button Grid.Column="2" Height="30" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding RestartCommand}"
                            Content="{l:Tr 'Restart'}" IsEnabled="{Binding HasFrames}" />
                </Grid>
                <StackPanel IsEnabled="{Binding HasFrames}" Spacing="2" Margin="0,6,0,0">
                    <Grid Classes="row" ColumnDefinitions="50,*,56">
                        <TextBlock Text="{l:Tr 'Frame'}" />
                        <Slider Grid.Column="1" VerticalAlignment="Center" Minimum="{Binding StartFrame}" Maximum="{Binding EndFrame}" Value="{Binding Frame}"
                                IsSnapToTickEnabled="True" TickFrequency="1" Margin="4,0" />
                        <NumericUpDown Grid.Column="2" Value="{Binding Frame, Converter={x:Static c:IntToDecimalConverter.Instance}}"
                                       Minimum="{Binding StartFrame}" Maximum="{Binding EndFrame}" FormatString="0" ShowButtonSpinner="False"
                                       VerticalAlignment="Center" />
                    </Grid>
                    <Grid Classes="row" ColumnDefinitions="50,*,8,40,*">
                        <TextBlock Text="{l:Tr 'Start'}" />
                        <NumericUpDown Grid.Column="1" Value="{Binding StartFrame, Converter={x:Static c:IntToDecimalConverter.Instance}}"
                                       Minimum="0" Maximum="{Binding MaxFrame}" FormatString="0" />
                        <TextBlock Grid.Column="3" Text="{l:Tr 'End'}" Classes="dim" VerticalAlignment="Center" />
                        <NumericUpDown Grid.Column="4" Value="{Binding EndFrame, Converter={x:Static c:IntToDecimalConverter.Instance}}"
                                       Minimum="0" Maximum="{Binding MaxFrame}" FormatString="0" />
                    </Grid>
                </StackPanel>
            </StackPanel>

            <!-- ===== Gameplay ===== -->
            <StackPanel IsVisible="{Binding IsGameplayMode}" Margin="0,10,0,0" Spacing="4">
                <Button Height="30" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding RestartCommand}"
                        Content="{l:Tr 'Restart'}" IsEnabled="{Binding CanRestart}" ToolTip.Tip="{l:Tr 'Spawn the runner again where it last spawned'}" />
                <Grid ColumnDefinitions="110,*" IsVisible="{Binding IsGameplaySpawned}">
                    <TextBlock Classes="dim" Text="{l:Tr 'Move'}" />
                    <TextBlock Grid.Column="1" Text="{Binding GameplayStateText}" TextTrimming="CharacterEllipsis" />
                </Grid>
            </StackPanel>

            <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Classes="dim" FontSize="11" IsVisible="{Binding IsAnimationMode}"
                       Text="{l:Tr 'Spawn, then click in the Scene to add the runner (hold C to stick to platforms, Esc to stop). The character stays visible while you keep building; Clear removes it. Spawns and Trick Areas also have a Preview Animation button in the Inspector.'}" />
            <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Classes="dim" FontSize="11" IsVisible="{Binding IsGameplayMode}"
                       Text="{l:Tr 'Spawn, then click in the Scene: the runner starts with JumpOff and runs on the level\'s Platforms, Trapezoids and Areas. Play it with the arrow keys. Click again to spawn it somewhere else (Esc stops spawning); after a death it falls until Clear or Restart. The Game View follows it. Triggers are not run.'}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
