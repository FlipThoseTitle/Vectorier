<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Vectorier.ViewModels.Dialogs"
             x:Class="Vectorier.Views.Dialogs.MessageDialogView"
             x:DataType="vm:MessageDialogViewModel"
             MinWidth="360" MaxWidth="560">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource AppToolbarBackground}"
                BorderBrush="{DynamicResource AppBorder}" BorderThickness="0,1,0,0" Padding="12,8">
            <ItemsControl ItemsSource="{Binding Buttons}" HorizontalAlignment="Right">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DialogButton">
                        <Button Content="{Binding Text}" MinWidth="80" HorizontalContentAlignment="Center"
                                IsEnabled="{Binding IsEnabled}"
                                IsDefault="{Binding IsDefault}" IsCancel="{Binding IsCancel}"
                                Classes.accent="{Binding IsDefault}"
                                Command="{Binding $parent[UserControl].((vm:MessageDialogViewModel)DataContext).PressCommand}"
                                CommandParameter="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
        <Grid ColumnDefinitions="Auto,*" Margin="18,16,18,16">
            <Panel Width="32" Height="32" VerticalAlignment="Top" Margin="0,0,14,0">
                <PathIcon Data="{StaticResource Icon.Alert}" Width="28" Height="28" Foreground="{DynamicResource AppDanger}" IsVisible="{Binding IsError}" />
                <PathIcon Data="{StaticResource Icon.Alert}" Width="28" Height="28" Foreground="{DynamicResource AppWarning}" IsVisible="{Binding IsWarning}" />
                <PathIcon Data="{StaticResource Icon.Info}" Width="28" Height="28" Foreground="{DynamicResource AppAccent}" IsVisible="{Binding IsQuestion}" />
                <PathIcon Data="{StaticResource Icon.Info}" Width="28" Height="28" Foreground="{DynamicResource AppAccent}" IsVisible="{Binding IsInfo}" />
                <PathIcon Data="{StaticResource Icon.Pencil}" Width="26" Height="26" Foreground="{DynamicResource AppAccent}" IsVisible="{Binding ShowInput}" />
            </Panel>
            <StackPanel Grid.Column="1" Spacing="8">
                <SelectableTextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                <CheckBox Content="{Binding CheckBoxText}" IsChecked="{Binding IsChecked}" IsVisible="{Binding ShowCheckBox}" />
                <TextBox x:Name="Input" Text="{Binding InputText}" IsVisible="{Binding ShowInput}" MinWidth="300" />
                <TextBlock Classes="error" Text="{Binding ValidationError}" IsVisible="{Binding ValidationError, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
