<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Vectorier_Editor_Avalonia"
             x:Class="Vectorier_Editor_Avalonia.App"
             Name="Vectorier"
             RequestedThemeVariant="Light">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Vectorier-Editor-Avalonia/Styles/Icons.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Windows 10 style: square-ish corners, compact controls -->
            <CornerRadius x:Key="ControlCornerRadius">2</CornerRadius>
            <CornerRadius x:Key="OverlayCornerRadius">2</CornerRadius>
            <FontFamily x:Key="AppFontFamily">Segoe UI, Inter</FontFamily>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppWindowBackground" Color="#F0F0F0" />
                    <SolidColorBrush x:Key="AppPanelBackground" Color="#FBFBFB" />
                    <SolidColorBrush x:Key="AppPanelAltBackground" Color="#F4F4F4" />
                    <SolidColorBrush x:Key="AppHeaderBackground" Color="#E4E4E4" />
                    <SolidColorBrush x:Key="AppToolbarBackground" Color="#EDEDED" />
                    <SolidColorBrush x:Key="AppBorder" Color="#C8C8C8" />
                    <SolidColorBrush x:Key="AppBorderStrong" Color="#A8A8A8" />
                    <SolidColorBrush x:Key="AppForeground" Color="#1E1E1E" />
                    <SolidColorBrush x:Key="AppForegroundDim" Color="#6D6D6D" />
                    <SolidColorBrush x:Key="AppHover" Color="#E5F1FB" />
                    <SolidColorBrush x:Key="AppSelection" Color="#CCE8FF" />
                    <SolidColorBrush x:Key="AppSelectionBorder" Color="#99D1FF" />
                    <SolidColorBrush x:Key="AppAccent" Color="#0078D7" />
                    <SolidColorBrush x:Key="AppIconForeground" Color="#3A3A3A" />
                    <SolidColorBrush x:Key="AppTabActive" Color="#FBFBFB" />
                    <SolidColorBrush x:Key="AppTabInactive" Color="#DADADA" />
                    <SolidColorBrush x:Key="AppDanger" Color="#C42B1C" />
                    <SolidColorBrush x:Key="AppWarning" Color="#9D5D00" />
                    <SolidColorBrush x:Key="AppThumbnailBackground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AppGhostForeground" Color="#8A8A8A" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppWindowBackground" Color="#202020" />
                    <SolidColorBrush x:Key="AppPanelBackground" Color="#2B2B2B" />
                    <SolidColorBrush x:Key="AppPanelAltBackground" Color="#262626" />
                    <SolidColorBrush x:Key="AppHeaderBackground" Color="#333333" />
                    <SolidColorBrush x:Key="AppToolbarBackground" Color="#2D2D2D" />
                    <SolidColorBrush x:Key="AppBorder" Color="#3F3F3F" />
                    <SolidColorBrush x:Key="AppBorderStrong" Color="#555555" />
                    <SolidColorBrush x:Key="AppForeground" Color="#E6E6E6" />
                    <SolidColorBrush x:Key="AppForegroundDim" Color="#9A9A9A" />
                    <SolidColorBrush x:Key="AppHover" Color="#3A3D41" />
                    <SolidColorBrush x:Key="AppSelection" Color="#264F78" />
                    <SolidColorBrush x:Key="AppSelectionBorder" Color="#3B76AE" />
                    <SolidColorBrush x:Key="AppAccent" Color="#4CA3F0" />
                    <SolidColorBrush x:Key="AppIconForeground" Color="#D4D4D4" />
                    <SolidColorBrush x:Key="AppTabActive" Color="#2B2B2B" />
                    <SolidColorBrush x:Key="AppTabInactive" Color="#252525" />
                    <SolidColorBrush x:Key="AppDanger" Color="#FF6B5E" />
                    <SolidColorBrush x:Key="AppWarning" Color="#FCC35B" />
                    <SolidColorBrush x:Key="AppThumbnailBackground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AppGhostForeground" Color="#7D7D7D" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme DensityStyle="Compact" />
        <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
        <StyleInclude Source="avares://Vectorier-Editor-Avalonia/Styles/AppStyles.axaml" />
    </Application.Styles>
</Application>
