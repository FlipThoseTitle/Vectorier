<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Vectorier_Editor_Avalonia.ViewModels.Dialogs"
             x:Class="Vectorier_Editor_Avalonia.Views.Dialogs.ImportDialogView"
             x:DataType="vm:ImportDialogViewModel"
             MinWidth="480" MinHeight="320">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource AppToolbarBackground}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                    <Button Command="{Binding AddFilesCommand}" ToolTip.Tip="Pick files">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource Icon.File}" Width="13" Height="13" />
                            <TextBlock Text="Add Files..." />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding AddFoldersCommand}" IsVisible="{Binding CanPickFolders}" ToolTip.Tip="Pick folders (imported recursively)">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource Icon.Folder}" Width="13" Height="13" />
                            <TextBlock Text="Add Folders..." />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock Classes="dim" Text="{Binding Hint}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource AppToolbarBackground}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="0,1,0,0" Padding="12,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                    <Button Content="Cancel" MinWidth="80" Command="{Binding CancelDialogCommand}" IsCancel="True" />
                    <Button Classes="accent" Content="Import" MinWidth="80" Command="{Binding ImportCommand}" IsDefault="True" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Classes="dim" Text="{Binding Summary}" />
                    <Button Classes="tool" Content="Clear" Command="{Binding ClearCommand}" IsVisible="{Binding HasEntries}" Padding="2,0" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Panel Name="DropZone" Background="Transparent" DragDrop.AllowDrop="True">
            <TextBlock Classes="dim" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="24"
                       Text="Add files and folders with the buttons above, or drop them here. Files and folders can be imported together."
                       IsVisible="{Binding !HasEntries}" />
            <ScrollViewer Margin="6">
                <ItemsControl ItemsSource="{Binding Entries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ImportEntry">
                            <Border Padding="6,3" CornerRadius="3" Classes="import-row">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Classes="tool" Padding="2" MinWidth="20" MinHeight="20" ToolTip.Tip="Remove"
                                            Command="{Binding $parent[UserControl].((vm:ImportDialogViewModel)DataContext).RemoveCommand}" CommandParameter="{Binding}">
                                        <PathIcon Data="{StaticResource Icon.Close}" Width="10" Height="10" />
                                    </Button>
                                    <Panel Width="14" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <PathIcon Data="{StaticResource Icon.Folder}" IsVisible="{Binding IsFolder}" Width="13" Height="13" />
                                        <PathIcon Data="{StaticResource Icon.File}" IsVisible="{Binding IsFile}" Width="13" Height="13" />
                                    </Panel>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Classes="dim" FontSize="11" Text="{Binding Location}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Location}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Panel>
    </DockPanel>
</UserControl>
