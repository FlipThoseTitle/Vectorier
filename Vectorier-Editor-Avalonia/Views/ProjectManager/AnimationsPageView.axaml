<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Vectorier_Editor_Avalonia.ViewModels.ProjectManager"
             x:Class="Vectorier_Editor_Avalonia.Views.ProjectManager.AnimationsPageView"
             x:DataType="vm:AnimationsPageViewModel">
    <DockPanel>
        <Border DockPanel.Dock="Top" Classes="panel" Padding="10,8" Margin="0,0,0,8">
            <Grid ColumnDefinitions="140,*,Auto">
                <TextBlock Text="Moves XML" FontWeight="SemiBold" />
                <TextBox Grid.Column="1" IsReadOnly="True" Text="{Binding MovesFile}" />
                <Button Grid.Column="2" Margin="6,0,0,0" Command="{Binding ChooseMovesCommand}" ToolTip.Tip="Choose a moves XML (saved as animations/moves.xml)">
                    <StackPanel Orientation="Horizontal" Spacing="4"><PathIcon Data="{StaticResource Icon.FolderOpen}" /><TextBlock Text="Browse…" /></StackPanel>
                </Button>
            </Grid>
        </Border>
        <Border Classes="panel" DragDrop.AllowDrop="True" x:Name="DropArea">
            <DockPanel>
                <Border DockPanel.Dock="Top" Classes="toolbar">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" Spacing="1">
                            <Button Classes="tool" ToolTip.Tip="Import Animations…" Command="{Binding ImportCommand}"><PathIcon Data="{StaticResource Icon.Import}" /></Button>
                            <Button Classes="tool" ToolTip.Tip="Delete Selected" Command="{Binding DeleteSelectedCommand}"><PathIcon Data="{StaticResource Icon.Delete}" /></Button>
                            <Button Classes="tool" ToolTip.Tip="Reload" Command="{Binding ReloadCommand}"><PathIcon Data="{StaticResource Icon.Refresh}" /></Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                            <Button Command="{Binding PreviewCommand}" IsVisible="{Binding CanPreview}"
                                    ToolTip.Tip="Play the selected animation on models/0.xml + 1.xml">
                                <StackPanel Orientation="Horizontal" Spacing="4"><PathIcon Data="{StaticResource Icon.Play}" /><TextBlock Text="Preview" /></StackPanel>
                            </Button>
                            <TextBlock Classes="dim" VerticalAlignment="Center" Text="{Binding CountText}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <ListBox x:Name="List" Classes="compact" DoubleTapped="OnItemDoubleTapped" ItemsSource="{Binding Items}" SelectionMode="Multiple" Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{StaticResource Icon.Animations}" />
                                <TextBlock Text="{Binding}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
